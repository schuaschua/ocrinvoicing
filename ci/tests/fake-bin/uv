#!/usr/bin/env python3
"""Test double for uv in ci/tests: records its arguments and the libpq PG* environment
to $FAKE_UV_LOG (one JSON object per call); fails when FAKE_UV_LOG is not set.
`uv export ... -o FILE` writes a one-package requirements file to FILE."""

import json
import os
import sys

if "FAKE_UV_LOG" not in os.environ:
    print("FAKE-TOOL-CALLED: uv " + " ".join(sys.argv[1:]), file=sys.stderr)
    sys.exit(97)
with open(os.environ["FAKE_UV_LOG"], "a", encoding="utf-8") as log:
    pg = {key: value for key, value in os.environ.items() if key.startswith("PG")}
    log.write(json.dumps({"args": sys.argv[1:], "env": pg}) + "\n")
args = sys.argv[1:]
if args[:1] == ["export"] and "-o" in args:
    with open(args[args.index("-o") + 1], "w", encoding="utf-8") as out:
        out.write("azure-functions==2.3.0 \\\n    --hash=sha256:" + "0" * 64 + "\n")
