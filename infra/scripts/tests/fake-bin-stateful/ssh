#!/usr/bin/env python3
"""Test double for ssh and scp (scp is a link to this file): records the call in
$FAKE_AZ_LOG as ["__ssh__", ...] or ["__scp__", ...]. For the ci-vm-remote.sh call it
also saves what arrived on standard input (the token) to $FAKE_AZ_LOG.stdin. Never
connects anywhere."""
import json, os, sys

tool = os.path.basename(sys.argv[0])
args = sys.argv[1:]
with open(os.environ["FAKE_AZ_LOG"], "a", encoding="utf-8") as log:
    log.write(json.dumps([f"__{tool}__", *args]) + "\n")
if tool == "ssh" and any("ci-vm-remote.sh" in arg for arg in args):
    with open(os.environ["FAKE_AZ_LOG"] + ".stdin", "w", encoding="utf-8") as out:
        out.write(sys.stdin.read())
sys.exit(0)
