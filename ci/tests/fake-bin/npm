#!/usr/bin/env python3
"""Test double for npm in ci/tests: logs its arguments to $FAKE_NPM_LOG (one JSON array
per line); fails when FAKE_NPM_LOG is not set. `npm run --prefix DIR build` writes
DIR/dist/index.html unless FAKE_NPM_NO_DIST is set."""

import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
if "FAKE_NPM_LOG" not in os.environ:
    print("FAKE-TOOL-CALLED: npm " + " ".join(args), file=sys.stderr)
    sys.exit(97)
with open(os.environ["FAKE_NPM_LOG"], "a", encoding="utf-8") as log:
    log.write(json.dumps(args) + "\n")
if args[:1] == ["run"] and "build" in args and "FAKE_NPM_NO_DIST" not in os.environ:
    dist = Path(args[args.index("--prefix") + 1]) / "dist"
    dist.mkdir(parents=True, exist_ok=True)
    (dist / "index.html").write_text("<!doctype html><title>fixture</title>\n", encoding="utf-8")
