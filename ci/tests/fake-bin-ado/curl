#!/usr/bin/env python3
"""Test double for curl in ci/ado-status.sh: logs each call as one JSON line to
$FAKE_CURL_LOG ({"argv": [...], "stdin": "..."}) and answers the Azure DevOps REST calls:
  .../pullrequests?...          {"value": $FAKE_ADO_PRS}          (a JSON list, default [])
  .../pullRequests/<id>/iterations  {"value": $FAKE_ADO_ITERATIONS} (default [])
  .../pullRequests/<id>/statuses    {} (the POST body is in argv after --data)
Never connects anywhere."""
import json, os, sys

args = sys.argv[1:]
stdin = sys.stdin.read() if "--config" in args else ""
with open(os.environ["FAKE_CURL_LOG"], "a", encoding="utf-8") as log:
    log.write(json.dumps({"argv": args, "stdin": stdin}) + "\n")
url = args[-1]
if "/iterations?" in url:
    print(json.dumps({"value": json.loads(os.environ.get("FAKE_ADO_ITERATIONS", "[]"))}))
elif "/statuses?" in url:
    print("{}")
elif "/pullrequests?" in url:
    print(json.dumps({"value": json.loads(os.environ.get("FAKE_ADO_PRS", "[]"))}))
else:
    print(f"unexpected URL {url}", file=sys.stderr)
    sys.exit(22)
